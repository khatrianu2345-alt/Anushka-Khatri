{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated BloomBox customer profile synchronized on Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Customer display name from Google profile.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address.",
          "minLength": 3,
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "description": "Optional Google profile photo URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A BloomBox personalized surprise order placed by an authenticated customer.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Human-readable BloomBox order code (e.g. BB-DDN-1042).",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID matching parent user document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientName": {
          "type": "string",
          "description": "Name of the gift recipient.",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number for delivery coordination.",
          "minLength": 7,
          "maxLength": 25
        },
        "address": {
          "type": "string",
          "description": "Street, hostel, or campus delivery address.",
          "minLength": 4,
          "maxLength": 300
        },
        "pincode": {
          "type": "string",
          "description": "6-digit Indian postal PIN code.",
          "minLength": 4,
          "maxLength": 10
        },
        "slotLabel": {
          "type": "string",
          "description": "Selected delivery slot label.",
          "minLength": 2,
          "maxLength": 80
        },
        "paymentMethod": {
          "type": "string",
          "description": "Selected payment mode.",
          "minLength": 2,
          "maxLength": 60
        },
        "total": {
          "type": "number",
          "description": "Final order total in INR."
        },
        "itemCount": {
          "type": "number",
          "description": "Total quantity of gift boxes in the order."
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "preparing", "out-for-delivery", "delivered"],
          "description": "Order fulfillment status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was placed."
        }
      },
      "required": [
        "orderId",
        "userId",
        "recipientName",
        "phone",
        "address",
        "pincode",
        "slotLabel",
        "paymentMethod",
        "total",
        "itemCount",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile keyed by Firebase Auth UID."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer's surprise gift orders stored under their user document."
    }
  }
}
