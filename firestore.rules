rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data, userId) {
      return data.keys().hasAll([
          'orderId',
          'userId',
          'recipientName',
          'phone',
          'address',
          'pincode',
          'slotLabel',
          'paymentMethod',
          'total',
          'itemCount',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'orderId',
          'userId',
          'recipientName',
          'phone',
          'address',
          'pincode',
          'slotLabel',
          'paymentMethod',
          'total',
          'itemCount',
          'status',
          'createdAt'
        ])
        && data.orderId is string
        && data.orderId.size() >= 4
        && data.orderId.size() <= 32
        && data.orderId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.recipientName is string
        && data.recipientName.size() >= 1
        && data.recipientName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 25
        && data.address is string
        && data.address.size() >= 4
        && data.address.size() <= 300
        && data.pincode is string
        && data.pincode.size() >= 4
        && data.pincode.size() <= 10
        && data.slotLabel is string
        && data.slotLabel.size() >= 2
        && data.slotLabel.size() <= 80
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 2
        && data.paymentMethod.size() <= 60
        && data.total is number
        && data.total > 0
        && data.itemCount is number
        && data.itemCount >= 1
        && data.status is string
        && data.status == 'confirmed'
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /orders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(orderId)
          && isOwner(userId)
          && isValidOrder(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }
    }
  }
}
